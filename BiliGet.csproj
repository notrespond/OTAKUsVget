<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BiliGet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AssemblyName>OTAKUsVget</AssemblyName>
    <ApplicationTitle>OTAKUsVget</ApplicationTitle>
    <ApplicationIcon>Assets\OTAKUsVget.ico</ApplicationIcon>
    <Version>1.1.14</Version>
    <AssemblyVersion>1.1.14.0</AssemblyVersion>
    <FileVersion>1.1.14.0</FileVersion>
    <Product>OTAKUsVget</Product>
    <Description>基于 yt-dlp 的视频下载工具（支持 B 站等）</Description>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <!-- 只保留中英文语言资源（体积/文件数优化） -->
    <SatelliteResourceLanguages>zh-CN;zh-TW;en-US;en-us</SatelliteResourceLanguages>
    <KeptLangPattern>^(zh-CN|zh-TW|en-US|en-us)$</KeptLangPattern>
  </PropertyGroup>

  <!-- 发布后删除多余的语言文件夹（Windows App SDK 的 .mui 语言资源） -->
  <Target Name="TrimUnusedLanguages" AfterTargets="Publish">
    <ItemGroup>
      <_LangDir Remove="@(_LangDir)" />
      <_LangDir Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
    </ItemGroup>
    <RemoveDir Directories="@(_LangDir)"
               Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})+$')) And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '$(KeptLangPattern)'))" />
  </Target>


  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="tools\yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\aria2c.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\OTAKUsVget.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\OTAKUsVget.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
