<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BiliGet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Host">
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="Assets/OTAKUsVget.png" Width="20" Height="20" />
                <TextBlock Text="OTAKUsVget" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextDim}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="RailRoot" Grid.Column="0" Background="Transparent">
                <StackPanel VerticalAlignment="Top" Spacing="6" Margin="0,10,0,0">
                    <Button x:Name="AvatarBtn" Width="44" Height="44" CornerRadius="22" Padding="0" Margin="0,0,0,6"
                            HorizontalAlignment="Center"
                            Click="Avatar_Click" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="账号 / 登录">
                        <Grid Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="38" Height="38" Fill="{ThemeResource RowHover}" />
                            <FontIcon x:Name="AvatarDefault" Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource TextDim}" />
                            <Ellipse Width="38" Height="38">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Button>
                    <Button x:Name="TabSearch" Style="{StaticResource RailBtn}" Click="Nav_Click" Tag="search" ToolTipService.ToolTip="搜索">
                        <FontIcon Glyph="&#xE721;" />
                    </Button>
                    <Button x:Name="TabHistory" Style="{StaticResource RailBtn}" Click="Nav_Click" Tag="history" ToolTipService.ToolTip="历史">
                        <FontIcon Glyph="&#xE81C;" />
                    </Button>
                    <Button x:Name="TabDownload" Style="{StaticResource RailBtn}" Click="Nav_Click" Tag="download" ToolTipService.ToolTip="下载">
                        <FontIcon Glyph="&#xE896;" />
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Spacing="6" Margin="0,0,0,10">
                    <Button x:Name="TabTheme" Style="{StaticResource RailBtn}" Click="ToggleTheme_Click" ToolTipService.ToolTip="切换主题">
                        <FontIcon Glyph="&#xE793;" />
                    </Button>
                    <Button x:Name="TabSettings" Style="{StaticResource RailBtn}" Click="Nav_Click" Tag="settings" ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                    <Button x:Name="TabAbout" Style="{StaticResource RailBtn}" Click="Nav_Click" Tag="about" ToolTipService.ToolTip="关于">
                        <FontIcon Glyph="&#xE946;" />
                    </Button>
                </StackPanel>
                <Border x:Name="NavIndicator" Width="3" Height="20" CornerRadius="2" Background="{StaticResource AccentGrad}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,0,0,0" IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NavIndicatorTf" />
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="SearchBar" Grid.Row="0" CornerRadius="22" Height="44" Margin="16,8,16,8"
                        Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="2"
                        PointerEntered="SearchBar_PointerEntered" PointerExited="SearchBar_PointerExited">
                    <Border.Resources>
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessDisabled">0</Thickness>
                    </Border.Resources>
                    <Grid ColumnSpacing="6" Padding="14,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="15"
                                  Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                        <TextBox x:Name="UrlBox" Grid.Column="1" PlaceholderText="输入 BV 号或链接"
                                 Background="{x:Null}" BorderThickness="0" CornerRadius="0" MinHeight="0" MinWidth="0"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="4,0,0,0"
                                 GotFocus="UrlBox_GotFocus" LostFocus="UrlBox_LostFocus"
                                 KeyDown="UrlBox_KeyDown" />
                        <Button Grid.Column="2" Width="36" Height="36" CornerRadius="18" Click="Parse_Click" ToolTipService.ToolTip="解析"
                                Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" BorderThickness="0">
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="White" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                        <Canvas Width="140" Height="110">
                            <Ellipse Canvas.Left="38" Canvas.Top="26" Width="48" Height="48"
                                     Stroke="{ThemeResource FieldBorder}" StrokeThickness="2.5" />
                            <Line X1="80" Y1="68" X2="100" Y2="88" Stroke="{ThemeResource Accent}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="54" Y1="44" X2="70" Y2="60" Stroke="{ThemeResource Accent}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="70" Y1="44" X2="54" Y2="60" Stroke="{ThemeResource Accent}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="今天想搜些什么呢~" HorizontalAlignment="Center" Foreground="{ThemeResource TextDim}" />
                    </StackPanel>

                    <!-- 解析结果 -->
                    <ScrollViewer x:Name="ResultPage" Visibility="Collapsed" Padding="18">
                        <StackPanel Spacing="14">
                            <!-- 骨架占位 -->
                            <StackPanel x:Name="ParseSkeleton" Spacing="14">
                                <Border Background="{ThemeResource CardBg}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <Border Width="200" Height="120" CornerRadius="8" Background="{ThemeResource RowHover}" />
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <Border Height="18" Width="320" CornerRadius="4" Background="{ThemeResource RowHover}" />
                                            <Border Height="14" Width="200" CornerRadius="4" Background="{ThemeResource RowHover}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 真实内容 -->
                            <StackPanel x:Name="ResultBody" Spacing="14" Visibility="Collapsed">
                                <Border Background="{ThemeResource CardBg}" CornerRadius="12" Padding="14" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <Border Width="160" Height="90" CornerRadius="8" Background="{ThemeResource RowHover}">
                                                <Image x:Name="ResCover" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Spacing="6" VerticalAlignment="Center" MaxWidth="560">
                                                <TextBlock x:Name="ResTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="ResMeta" Foreground="{ThemeResource TextDim}" FontSize="12.5" />
                                                <Button x:Name="DownloadCoverBtn" Content="下载封面" Padding="10,3" FontSize="12"
                                                        HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="保存为 JPG" Click="SaveCoverJpg_Click" />
                                                            <MenuFlyoutItem Text="保存为 PNG" Click="SaveCoverPng_Click" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Height="1" Background="{ThemeResource CardBorder}" />
                                        <StackPanel x:Name="PartsRow" Visibility="Collapsed" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="PartsLabel" Text="分P" VerticalAlignment="Center" Foreground="{ThemeResource TextDim}" Margin="2,0,4,0" />
                                            <ComboBox x:Name="PartsBox" Width="380" VerticalAlignment="Center" Style="{StaticResource ComboField}" SelectionChanged="PartsBox_SelectionChanged" />
                                        </StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="类型" VerticalAlignment="Center" Foreground="{ThemeResource TextDim}" Margin="2,0,4,0" />
                                                <ComboBox x:Name="TypeBox" Width="104" VerticalAlignment="Center" Style="{StaticResource ComboField}" SelectionChanged="TypeBox_SelectionChanged">
                                                    <ComboBoxItem Content="视频" IsSelected="True" />
                                                    <ComboBoxItem Content="仅音频" />
                                                </ComboBox>
                                                <StackPanel x:Name="VideoOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="清晰度" VerticalAlignment="Center" Foreground="{ThemeResource TextDim}" Margin="10,0,4,0" />
                                                    <ComboBox x:Name="FormatBox" Width="150" VerticalAlignment="Center" Style="{StaticResource ComboField}" />
                                                    <ProgressRing x:Name="FmtRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed"
                                                                  Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                    <TextBlock Text="编码" VerticalAlignment="Center" Foreground="{ThemeResource TextDim}" Margin="10,0,4,0" />
                                                    <ComboBox x:Name="CodecBox" Width="96" VerticalAlignment="Center" Style="{StaticResource ComboField}">
                                                        <ComboBoxItem Content="自动" IsSelected="True" />
                                                        <ComboBoxItem Content="H.264" />
                                                        <ComboBoxItem Content="H.265" />
                                                        <ComboBoxItem Content="AV1" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel x:Name="AudioOpts" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <TextBlock Text="音频格式" VerticalAlignment="Center" Foreground="{ThemeResource TextDim}" Margin="10,0,4,0" />
                                                    <ComboBox x:Name="AudioFmtBox" Width="110" VerticalAlignment="Center" Style="{StaticResource ComboField}">
                                                        <ComboBoxItem Content="mp3" IsSelected="True" />
                                                        <ComboBoxItem Content="m4a" />
                                                        <ComboBoxItem Content="flac" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Content="加入下载列表" x:Name="AddBatchBtn" Click="AddToBatch_Click" Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" Foreground="White"
                                                    BorderThickness="0" Height="34" Padding="18,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="BatchCard" Visibility="Collapsed" Background="{ThemeResource CardBg}" CornerRadius="12" Padding="14" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock x:Name="BatchTitle" Text="下载列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="清空" Click="ClearBatch_Click" />
                                                <Button Content="开始下载" Click="DownloadAll_Click" Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" Foreground="White" BorderThickness="0" />
                                            </StackPanel>
                                        </Grid>
                                        <ListView x:Name="BatchList" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,6" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="64" Height="36" CornerRadius="8" Background="{ThemeResource RowHover}">
                                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Meta}" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="移除" VerticalAlignment="Center" Click="RemoveBatch_Click"
                                                                Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 历史 -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed" Padding="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid x:Name="HistTabs" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Grid PointerEntered="HistTab_PointerEntered" PointerExited="HistTab_PointerExited">
                                        <Button x:Name="HistTabAll" Content="全部" CornerRadius="6" Padding="6,4" Background="Transparent" BorderThickness="0" Click="HistFilter_Click" Tag="all" />
                                        <Border x:Name="HistBadgeAll" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                Width="16" Height="16" CornerRadius="8" Padding="0" Background="#FF00AEEC" Opacity="0" IsHitTestVisible="False">
                                            <TextBlock x:Name="HistBadgeAllText" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid PointerEntered="HistTab_PointerEntered" PointerExited="HistTab_PointerExited">
                                        <Button x:Name="HistTabVideo" Content="视频" CornerRadius="6" Padding="6,4" Background="Transparent" BorderThickness="0" Click="HistFilter_Click" Tag="video" />
                                        <Border x:Name="HistBadgeVideo" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                Width="16" Height="16" CornerRadius="8" Padding="0" Background="#FF00AEEC" Opacity="0" IsHitTestVisible="False">
                                            <TextBlock x:Name="HistBadgeVideoText" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <Grid PointerEntered="HistTab_PointerEntered" PointerExited="HistTab_PointerExited">
                                        <Button x:Name="HistTabPgc" Content="番剧" CornerRadius="6" Padding="6,4" Background="Transparent" BorderThickness="0" Click="HistFilter_Click" Tag="pgc" />
                                        <Border x:Name="HistBadgePgc" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                Width="16" Height="16" CornerRadius="8" Padding="0" Background="#FF00AEEC" Opacity="0" IsHitTestVisible="False">
                                            <TextBlock x:Name="HistBadgePgcText" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <Border x:Name="HistUnderline" Height="2" Width="0" CornerRadius="1" Background="{StaticResource AccentGrad}"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Left" IsHitTestVisible="False">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="HistUnderlineTf" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="LoginState" Text="" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="HistMoreBtn" Content="加载更多" Click="LoadMoreHistory_Click" Visibility="Collapsed" />
                                <Button Content="刷新" Click="RefreshHistory_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="登录后可读取你的观看历史，一键选择下载。" Foreground="{ThemeResource TextDim}" FontSize="12.5" Margin="0,0,0,10" Visibility="Collapsed" />
                        <ListView x:Name="HistoryList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick" ContainerContentChanging="List_ContainerContentChanging">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8" ColumnSpacing="12" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="140" Height="88" CornerRadius="8" Background="{ThemeResource RowHover}">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sub}" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="HistEmpty" Grid.Row="2" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <Canvas Width="140" Height="110">
                                <Ellipse Canvas.Left="40" Canvas.Top="28" Width="60" Height="60"
                                         Stroke="{ThemeResource FieldBorder}" StrokeThickness="2.5" />
                                <Path Data="M70,40 L70,58 L84,66" Stroke="{ThemeResource Accent}" StrokeThickness="2.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M52,22 L40,34 M88,22 L100,34" Stroke="{ThemeResource FieldBorder}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="67" Canvas.Top="55" Width="6" Height="6" Fill="{ThemeResource Accent}" />
                            </Canvas>
                            <TextBlock Text="登录后可读取观看历史，一键选择下载" HorizontalAlignment="Center" Foreground="{ThemeResource TextDim}" />
                        </StackPanel>
                    </Grid>

                    <!-- 下载列表 -->
                    <Grid x:Name="DownloadsPage" Visibility="Collapsed" Padding="18">
                        <Grid.Resources>
                            <DataTemplate x:Key="DownloadItemTpl">
                                <Grid Padding="0,8" ColumnSpacing="12" Background="Transparent" RightTapped="DownloadItem_RightTapped">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="DownloadMenu_Opening">
                                            <MenuFlyoutItem Text="重新下载" Tag="redownload" Click="Redownload_Click" Visibility="Collapsed" />
                                            <MenuFlyoutItem Text="打开所在文件夹" Click="OpenDownloadFolder_Click" />
                                            <MenuFlyoutItem Text="删除记录" Click="RemoveDownload_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border Grid.Column="0" Width="96" Height="54" CornerRadius="8" Background="{ThemeResource RowHover}">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" Foreground="{ThemeResource TextPrimary}" FontSize="13" />
                                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="4" CornerRadius="2"
                                                     IsIndeterminate="{Binding Indeterminate}"
                                                     Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}"
                                                     Foreground="{StaticResource AccentGrad}" Background="{ThemeResource RowHover}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ButtonText}" Click="TogglePause_Click" VerticalAlignment="Center"
                                            Visibility="{Binding ButtonVisible, Converter={StaticResource BoolToVis}}"
                                            Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1" />
                                </Grid>
                            </DataTemplate>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="下载" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="清除记录" Click="ClearDownloads_Click" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <Expander x:Name="ActiveExp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Header="进行中" IsExpanded="True">
                                        <ListView x:Name="ActiveList" SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="DownloadList_ItemClick" ContainerContentChanging="List_ContainerContentChanging"
                                                  ItemTemplate="{StaticResource DownloadItemTpl}"
                                                  MaxHeight="420" />
                                    </Expander>
                                    <Expander x:Name="DoneExp" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Header="已完成" IsExpanded="False">
                                        <ListView x:Name="DoneList" SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="DownloadList_ItemClick" ContainerContentChanging="List_ContainerContentChanging"
                                                  ItemTemplate="{StaticResource DownloadItemTpl}"
                                                  MaxHeight="420" />
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel x:Name="DlEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                                <Canvas Width="140" Height="110">
                                    <Path Data="M28,48 L52,48 L58,58 L82,58 L88,48 L112,48 L112,88 L28,88 Z"
                                          Stroke="{ThemeResource FieldBorder}" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                    <Line X1="70" Y1="20" X2="70" Y2="58" Stroke="{ThemeResource Accent}" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path Data="M58,46 L70,58 L82,46" Stroke="{ThemeResource Accent}" StrokeThickness="2.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Line X1="44" Y1="96" X2="96" Y2="96" Stroke="{ThemeResource CardBorder}" StrokeThickness="2.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                                <TextBlock Text="还没有下载任务" HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimary}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="去搜索页解析视频，加入下载列表后开始下载" HorizontalAlignment="Center" Foreground="{ThemeResource TextDim}" FontSize="12.5" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 登录 -->
                    <Grid x:Name="LoginPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,10">
                            <TextBlock Text="登录 B 站" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="取消" Click="LoginCancel_Click" />
                            <Button Content="网页登录" Click="WebLogin_Click" />
                            <TextBlock x:Name="LoginMsg" VerticalAlignment="Center" Foreground="{ThemeResource TextDim}"
                                       Text="登录成功后会自动获取账号并载入观看历史…" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Border x:Name="LoginCard" Padding="28" CornerRadius="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                <Border.Resources>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </Border.Resources>
                                <Grid ColumnSpacing="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左：扫码登录 -->
                                    <StackPanel Grid.Column="0" Spacing="18" Width="240">
                                        <TextBlock Text="扫描二维码登录" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <Grid Width="212" Height="212" HorizontalAlignment="Center">
                                            <Border Background="White" CornerRadius="12" Padding="6">
                                                <Image x:Name="QrImage" Stretch="Uniform" />
                                            </Border>
                                            <Border x:Name="QrExpiredOverlay" Visibility="Collapsed" Background="#CC000000" CornerRadius="12"
                                                    Tapped="QrExpired_Tapped">
                                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                                                    <TextBlock Text="已过期，点击刷新" Foreground="White" FontSize="13" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="QrSuccessOverlay" Visibility="Collapsed" Background="#CC000000" CornerRadius="12">
                                                <FontIcon Glyph="&#xE73E;" FontSize="60" Foreground="#2EC46B"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <ScaleTransform x:Name="QrCheckTf" />
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="QrStatus" Text="正在获取二维码…" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextDim}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                                        <Button Click="QrRefresh_Click" HorizontalAlignment="Center" CornerRadius="8" Padding="12,7"
                                                Background="{ThemeResource RowHover}" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="刷新二维码" FontSize="12.5" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- 右：密码 / 短信 -->
                                    <StackPanel Grid.Column="1" Spacing="18" Width="380">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Button x:Name="TabPwd" Content="密码登录" FontSize="15" CornerRadius="8" Padding="14,5"
                                                    Background="Transparent" BorderThickness="0" Click="LoginTabPwd_Click" />
                                            <Button x:Name="TabSms" Content="短信登录" FontSize="15" CornerRadius="8" Padding="14,5"
                                                    Background="Transparent" BorderThickness="0" Click="LoginTabSms_Click" />
                                        </StackPanel>

                                        <StackPanel x:Name="SmsForm" Spacing="14">
                                            <Border Height="40" CornerRadius="8" Background="{ThemeResource FieldBg}" BorderBrush="{ThemeResource FieldBorder}" BorderThickness="1">
                                                <Grid Padding="12,0" ColumnSpacing="9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE717;" FontSize="15" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="PhoneBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                             MinHeight="0" MinWidth="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                             PlaceholderText="请输入手机号" MaxLength="11" InputScope="Number" />
                                                </Grid>
                                            </Border>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Height="40" CornerRadius="8" Background="{ThemeResource FieldBg}" BorderBrush="{ThemeResource FieldBorder}" BorderThickness="1">
                                                    <Grid Padding="12,0" ColumnSpacing="9">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                        <TextBox x:Name="SmsBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                                 MinHeight="0" MinWidth="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                                 PlaceholderText="请输入验证码" MaxLength="6" />
                                                    </Grid>
                                                </Border>
                                                <Button x:Name="SendSmsBtn" Grid.Column="1" Content="获取验证码" Height="40" CornerRadius="8" Click="SendSms_Click" />
                                            </Grid>
                                            <Button x:Name="SmsLoginBtn" Content="登录" Click="SmsLogin_Click" HorizontalAlignment="Stretch"
                                                    Height="44" CornerRadius="8"
                                                    Background="{StaticResource AccentGrad}" Foreground="White" BorderThickness="0" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <StackPanel x:Name="PwdForm" Visibility="Collapsed" Spacing="14">
                                            <Border Height="40" CornerRadius="8" Background="{ThemeResource FieldBg}" BorderBrush="{ThemeResource FieldBorder}" BorderThickness="1">
                                                <Grid Padding="12,0" ColumnSpacing="9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="UserBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                             MinHeight="0" MinWidth="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                             PlaceholderText="请输入账号（手机号 / 邮箱）" />
                                                </Grid>
                                            </Border>
                                            <Border Height="40" CornerRadius="8" Background="{ThemeResource FieldBg}" BorderBrush="{ThemeResource FieldBorder}" BorderThickness="1">
                                                <Grid Padding="12,0" ColumnSpacing="9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                    <PasswordBox x:Name="PwdBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                                 MinHeight="0" MinWidth="0" Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                                 PlaceholderText="请输入密码" />
                                                </Grid>
                                            </Border>
                                            <Button x:Name="PwdLoginBtn" Content="登录" Click="PwdLogin_Click" HorizontalAlignment="Stretch"
                                                    Height="44" CornerRadius="8"
                                                    Background="{StaticResource AccentGrad}" Foreground="White" BorderThickness="0" Margin="0,4,0,0" />
                                        </StackPanel>

                                        <TextBlock x:Name="PhoneMsg" Foreground="{ThemeResource TextDim}" FontSize="12"
                                                   HorizontalAlignment="Left" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{ThemeResource TextDim}" FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                   Text="登录即代表你同意哔哩哔哩的用户协议与隐私政策" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid x:Name="CaptchaPanel" Visibility="Collapsed" Background="#66000000" Tapped="CaptchaOverlay_Tapped">
                                <Grid x:Name="CaptchaHost" Width="386" Height="418" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Content="取消" Click="CancelCaptcha_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0" />
                            </Grid>

                            <Grid x:Name="WebPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Button Content="← 返回登录" Click="WebBack_Click" Margin="12,8,0,0" HorizontalAlignment="Left" />
                                <Grid x:Name="LoginHost" Grid.Row="1" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 设置 -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="修改后自动保存" Foreground="{ThemeResource TextDim}" FontSize="12" Margin="0,0,0,5" />
                            </StackPanel>
                            <Grid ColumnSpacing="14" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource CardBg}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                            <TextBlock Text="下载" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="下载目录" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="SetDir" Grid.Column="0" Style="{StaticResource InputBox}" TextChanged="AutoSave_TextChanged" />
                                            <Button Grid.Column="1" Content="浏览…" Click="PickDir_Click" />
                                            <Button Grid.Column="2" Content="打开" Click="OpenDir_Click" />
                                        </Grid>
                                        <TextBlock Text="清晰度偏好" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        <ComboBox x:Name="SetQuality" HorizontalAlignment="Stretch" Style="{StaticResource InputCombo}" SelectionChanged="AutoSave_SelectionChanged">
                                            <ComboBoxItem Content="最高画质" />
                                            <ComboBoxItem Content="1080P" />
                                            <ComboBoxItem Content="720P" />
                                        </ComboBox>
                                        <TextBlock Text="同时下载数" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        <ComboBox x:Name="SetConcurrent" HorizontalAlignment="Stretch" Style="{StaticResource InputCombo}" SelectionChanged="AutoSave_SelectionChanged">
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                            <ComboBoxItem Content="5" />
                                            <ComboBoxItem Content="6" />
                                            <ComboBoxItem Content="7" />
                                            <ComboBoxItem Content="8" />
                                        </ComboBox>
                                        <TextBlock Text="已内置 yt-dlp / aria2c / ffmpeg，无需安装或配置路径。" Foreground="{ThemeResource TextDim}" FontSize="12" TextWrapping="Wrap" />
                                        <CheckBox x:Name="SetSubs" Content="同时下载字幕（.srt，若视频有）" Checked="AutoSave_Check" Unchecked="AutoSave_Check" />
                                        <CheckBox x:Name="SetDelFile" Content="删除记录时同时删除文件" Checked="AutoSave_Check" Unchecked="AutoSave_Check" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource CardBg}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                            <TextBlock Text="账号与网络" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Cookie 文件（用于高清 / 大会员 / 历史）" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="SetCookie" Grid.Column="0" Style="{StaticResource InputBox}" TextChanged="AutoSave_TextChanged" />
                                            <Button Grid.Column="1" Content="浏览…" Click="PickCookie_Click" />
                                        </Grid>
                                        <TextBlock Text="代理（例如 http://127.0.0.1:7890，可留空）" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBox x:Name="SetProxy" Grid.Column="0" Style="{StaticResource InputBox}"
                                                     PlaceholderText="http://127.0.0.1:7890" TextChanged="AutoSave_TextChanged" />
                                            <Button Grid.Column="1" Content="测试连接" Click="TestProxy_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{ThemeResource CardBg}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                            <TextBlock Text="外观" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="主题" Width="64" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="SetTheme" Width="160" Style="{StaticResource InputCombo}" SelectionChanged="Theme_Changed">
                                                <ComboBoxItem Content="深色" />
                                                <ComboBoxItem Content="浅色" />
                                                <ComboBoxItem Content="跟随系统" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="背景材质" Width="64" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="SetBackdrop" Width="160" Style="{StaticResource InputCombo}" SelectionChanged="Backdrop_Changed">
                                                <ComboBoxItem Content="云母 Alt" />
                                                <ComboBoxItem Content="云母" />
                                                <ComboBoxItem Content="亚克力" />
                                                <ComboBoxItem Content="纯色" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="强调色" Width="64" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                            <ComboBox x:Name="SetAccent" Width="160" Style="{StaticResource InputCombo}" SelectionChanged="Accent_Changed">
                                                <ComboBoxItem Content="跟随系统" />
                                                <ComboBoxItem Content="B站蓝" />
                                                <ComboBoxItem Content="紫" />
                                                <ComboBoxItem Content="绿" />
                                                <ComboBoxItem Content="橙" />
                                                <ComboBoxItem Content="粉" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="0" Background="{ThemeResource CardBg}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                <TextBlock Text="缓存" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="清理下载过程中产生的缓存数据。" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="临时文件" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="8" Background="{ThemeResource RowHover}" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TempSizeText" Text="—" FontSize="12" Foreground="{ThemeResource TextDim}" />
                                                </Border>
                                                <Button Click="CleanTemp_Click" Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="清理临时文件">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="网页登录缓存" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="8" Background="{ThemeResource RowHover}" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="WebSizeText" Text="—" FontSize="12" Foreground="{ThemeResource TextDim}" />
                                                </Border>
                                                <Button Click="CleanWeb_Click" Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="清理网页登录缓存">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="封面缓存" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Border CornerRadius="8" Background="{ThemeResource RowHover}" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CoverSizeText" Text="—" FontSize="12" Foreground="{ThemeResource TextDim}" />
                                                </Border>
                                                <Button Click="CleanCover_Click" Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="清理封面缓存">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.Column="1" Background="{ThemeResource CardBg}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardBorder}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource TextDim}" VerticalAlignment="Center" />
                                                <TextBlock Text="应用更新" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Border x:Name="UpdChip" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    CornerRadius="12" Padding="10,2" Background="{ThemeResource RowHover}">
                                                <TextBlock x:Name="UpdChipText" Text="未检查" FontSize="12" Foreground="{ThemeResource TextDim}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Windows · x64" Foreground="{ThemeResource TextDim}" FontSize="12" />
                                        <TextBlock x:Name="UpdLine" Text="点「重新检查」获取更新。" Foreground="{ThemeResource TextDim}" FontSize="13" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="BtnCheckUpdate" Content="重新检查" Click="CheckUpdate_Click"
                                                    Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" Foreground="White" BorderThickness="0" />
                                            <Button Content="查看更新说明" Click="ShowChangelog_Click" />
                                            <Button x:Name="BtnUpdateNow" Content="下载更新" Click="DownloadUpdate_Click"
                                                    Visibility="Collapsed" Style="{StaticResource AnimAccentButton}" Background="{StaticResource AccentGrad}" Foreground="White" BorderThickness="0" />
                                        </StackPanel>
                                        <ProgressBar x:Name="UpdBar" Minimum="0" Maximum="100" Height="6" CornerRadius="3"
                                                     Visibility="Collapsed" Foreground="{ThemeResource Accent}" />
                                        <CheckBox x:Name="SetAutoCheck" Content="每次启动自动检查更新" Checked="AutoSave_Check" Unchecked="AutoSave_Check" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 关于 -->
                    <Grid x:Name="AboutPage" Visibility="Collapsed" Padding="24">
                        <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <Grid x:Name="AboutLogo" Width="120" Height="120" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="AboutLogoTr" />
                                </Grid.RenderTransform>
                                <Image Source="Assets/OTAKUsVget.png" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Text="OTAKUsVget" FontSize="32" FontWeight="Bold" FontStyle="Italic"
                                       HorizontalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1B3FA0" Offset="0" />
                                        <GradientStop Color="#0AA3FF" Offset="1" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Border HorizontalAlignment="Center" CornerRadius="12" Padding="10,3" Background="{ThemeResource RowHover}">
                                <TextBlock Text="版本 1.1.14" FontSize="12" Foreground="{ThemeResource TextDim}" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextDim}"
                                       Text="基于 yt-dlp 的视频下载工具，支持哔哩哔哩等站点。内置 yt-dlp / aria2c / ffmpeg，开箱即用。" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextDim}" FontSize="12"
                                       Text="仅供个人学习与合法用途，请勿用于侵权或再分发。" />
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Button Content="更新日志" Click="OpenDownloadPage_Click" />
                                <Button Content="访问网站" Click="OpenSite_Click" />
                            </StackPanel>
                            <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="开源项目" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Foreground="{ThemeResource TextDim}" />
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <HyperlinkButton Content="yt-dlp" FontSize="12" Padding="4,2" NavigateUri="https://github.com/yt-dlp/yt-dlp" />
                                    <HyperlinkButton Content="aria2" FontSize="12" Padding="4,2" NavigateUri="https://github.com/aria2/aria2" />
                                    <HyperlinkButton Content="FFmpeg" FontSize="12" Padding="4,2" NavigateUri="https://ffmpeg.org/" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <HyperlinkButton Content="QRCoder" FontSize="12" Padding="4,2" NavigateUri="https://github.com/codebude/QRCoder" />
                                    <HyperlinkButton Content="Windows App SDK" FontSize="12" Padding="4,2" NavigateUri="https://github.com/microsoft/WindowsAppSDK" />
                                    <HyperlinkButton Content=".NET" FontSize="12" Padding="4,2" NavigateUri="https://github.com/dotnet/runtime" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,30" Padding="18,13" MinWidth="380" MaxWidth="640" CornerRadius="12"
                            Background="{ThemeResource CardBg}" BorderBrush="{ThemeResource Accent}" BorderThickness="2"
                            Tapped="Toast_Tapped" ToolTipService.ToolTip="点击关闭">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ToastTf" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="ToastIcon" Glyph="&#xE946;" FontSize="20"
                                      Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ToastText" Foreground="{ThemeResource TextPrimary}" FontSize="14"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="ThemeSnapshotLayer" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border x:Name="ThemeSnapshotBg" Background="{ThemeResource AppBg}" />
            <Image x:Name="ThemeSnapshot" Stretch="Fill" />
        </Grid>
    </Grid>
    </Grid>
</Window>
